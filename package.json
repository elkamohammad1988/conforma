{
  "name": "conforma",
  "version": "1.1.0",
  "private": true,
  "description": "Conforma turns the EU AI Act (Regulation (EU) 2024/1689) into a guided workflow — inventory AI systems, auto-classify their risk tier with Article-level citations, close the obligations that apply, and generate audit-ready documentation.",
  "homepage": "https://github.com/elkamohammad1988/conforma#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elkamohammad1988/conforma.git"
  },
  "bugs": {
    "url": "https://github.com/elkamohammad1988/conforma/issues"
  },
  "license": "MIT",
  "keywords": [
    "eu-ai-act",
    "ai-governance",
    "compliance",
    "regulation-2024-1689",
    "risk-classification",
    "nextjs",
    "typescript",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "screenshots": "node scripts/screenshots.mjs",
    "demo:video": "node scripts/record-demo.mjs",
    "covers": "node scripts/covers.mjs",
    "verify:rls": "node --env-file=.env.local scripts/verify-rls.mjs",
    "check:env": "node scripts/check-env.mjs",
    "seed": "node --env-file=.env.local scripts/seed.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.110.0",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^22.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.61.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
