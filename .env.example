# =============================================================================
# Conforma — environment variables
# Copy to .env.local (git-ignored) and fill in. Everything here is optional:
# the product runs fully offline with deterministic templates when no key is set.
# =============================================================================

# ---- Anthropic (AI document drafting + classification narrative) -----------
# When present, Conforma uses Claude (claude-opus-4-8) to draft system-specific
# compliance documents and plain-language explanations. When absent, it falls
# back to structured offline templates — so the demo works with zero credentials.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# ---- App -------------------------------------------------------------------
# Public base URL (used for absolute links / OG tags when deployed).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
