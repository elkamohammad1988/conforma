# =============================================================================
# Conforma — environment variables
# Copy to .env.local (git-ignored) and fill in. Everything here is optional:
# with no key set the product runs in Demo Mode (see below) and stays fully
# functional — no paid API required.
# =============================================================================

# ---- Anthropic (AI document drafting + classification narrative) -----------
# When present, Conforma uses Claude (claude-opus-4-8) to draft system-specific
# compliance documents and plain-language explanations.
#
# When ABSENT, the app automatically switches to DEMO MODE: it returns realistic,
# pre-generated AI documents (clearly labelled in the UI), shows no errors and
# breaks no user flow — so the public GitHub repo and the Vercel deployment work
# with zero credentials. Add a key only to upgrade Demo Mode to live drafting.
# Get a key at https://console.anthropic.com/


ANTHROPIC_API_KEY=""

# ---- App -------------------------------------------------------------------
# Public base URL — used for canonical tags, Open Graph, the sitemap and robots.
# Locally, http://localhost:3000 is fine. In production set this to your deployed
# origin (e.g. https://conforma-ten.vercel.app, or your custom domain); when unset
# the app falls back to the live deployment URL so metadata stays correct.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Supabase (production backend: database, auth, multi-tenancy) ----------
# Conforma is dual-mode. With NO Supabase vars set it runs in DEMO MODE exactly
# as before — the AI-system registry lives in the browser (localStorage), no
# login, zero credentials. The public repo and Vercel deploy keep working.
#
# Set the two NEXT_PUBLIC_ vars below to switch on PRODUCTION MODE: a real
# Postgres database with Row Level Security, authentication, organizations and
# per-tenant data isolation. The URL + anon key are safe to expose to the
# browser (RLS is what protects the data); the service-role key is NOT — it
# bypasses RLS and must stay server-side only.
#
# To provision: create a project at https://supabase.com, then from the repo run
#   supabase link --project-ref <your-project-ref>
#   supabase db push          # applies supabase/migrations/*
# The three values are in Project Settings → API. See docs/DATABASE.md.

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Demo override (portfolio / public deploy) -----------------------------
# Force DEMO MODE even when the Supabase vars above are set. Use this on the
# public portfolio deployment so anyone can explore the full product instantly —
# no sign-up, no login wall — while your real Supabase/Stripe config stays in
# place (the dual-mode architecture is still wired; this one flag flips it).
# Set to "1" (or "true") to enable. Leave empty for normal env-driven mode
# selection (Supabase present ⇒ Production Mode).
NEXT_PUBLIC_DEMO=""

# ---- Stripe (billing: Free / Pro / Team plans) -----------------------------
# Optional. With no Stripe keys, billing is inert: every org stays on the Free
# plan and the "Upgrade" surface explains that billing is not configured. Set
# these to enable subscriptions, the customer portal and webhook-driven plan
# state. Get keys at https://dashboard.stripe.com/apikeys.
#
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET are server-only secrets.
# Price IDs come from your Stripe product catalog (one product per paid plan,
# each with a monthly and an annual price).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_TEAM_MONTHLY=""
STRIPE_PRICE_TEAM_ANNUAL=""

# ---- Email (transactional: team invitations) -------------------------------
# Optional. Conforma sends team-invitation emails via Resend's REST API (no SDK).
# With both vars set, inviting a teammate emails them an accept link; without
# them, email is skipped and the invite still returns a shareable link — an
# invite never fails because email is unconfigured. Get a key at resend.com.
# EMAIL_FROM must be a verified sender, e.g. "Conforma <no-reply@yourdomain.com>".
# NOTE: this covers app-owned mail only; Supabase Auth sends signup/reset emails —
# configure a custom SMTP provider there for production deliverability.
RESEND_API_KEY=""
EMAIL_FROM=""

# ---- Ops -------------------------------------------------------------------
# Optional shared secret. When set, /api/health?deep=1 will only return the
# detailed env-configuration report (which vars are missing/partial) to a caller
# that presents it via `?token=` or the `x-health-token` header. Without it, the
# health endpoint still reports readiness, but never the config detail. Leave
# empty to keep config details fully private.
HEALTH_TOKEN=""
