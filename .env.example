# =============================================================================
# Conforma — environment variables
# Copy to .env.local (git-ignored) and fill in. Everything here is optional:
# with no key set the product runs in Demo Mode (see below) and stays fully
# functional — no paid API required.
# =============================================================================

# ---- Anthropic (AI document drafting + classification narrative) -----------
# When present, Conforma uses Claude (claude-opus-4-8) to draft system-specific
# compliance documents and plain-language explanations.
#
# When ABSENT, the app automatically switches to DEMO MODE: it returns realistic,
# pre-generated AI documents (clearly labelled in the UI), shows no errors and
# breaks no user flow — so the public GitHub repo and the Vercel deployment work
# with zero credentials. Add a key only to upgrade Demo Mode to live drafting.
# Get a key at https://console.anthropic.com/


ANTHROPIC_API_KEY=""

# ---- App -------------------------------------------------------------------
# Public base URL — used for canonical tags, Open Graph, the sitemap and robots.
# Locally, http://localhost:3000 is fine. In production set this to your deployed
# origin (e.g. https://conforma-ten.vercel.app, or your custom domain); when unset
# the app falls back to the live deployment URL so metadata stays correct.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
